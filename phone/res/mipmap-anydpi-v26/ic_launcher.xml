<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork slots (432 x 432 px PNGs, logo inside the centre 288 x 288):
     drawable-xxxhdpi/ic_fg.png = foreground (transparent), ic_bg.png = background, ic_mono.png = one-colour (themed icons) -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_bg"/>
    <foreground android:drawable="@drawable/ic_fg"/>
    <monochrome android:drawable="@drawable/ic_mono"/>
</adaptive-icon>
