<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.tvoverlaysuite" android:versionCode="10" android:versionName="1.7.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Granted only by the app's own one-time "Enable automatically" step (pm grant over the TV's adb), so it can
         switch its accessibility service back on after updates. Never requested at runtime. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:label="TV Overlay Suite" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:allowBackup="false">
        <activity android:name=".SetupActivity" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".MarkerService" android:exported="true"
            android:label="TV Overlay Suite"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/marker_service"/>
        </service>
        <!-- v1.5: the TV keyboard, which also lets the phone app type into any text box -->
        <service android:name=".KeysIME" android:exported="true"
            android:label="@string/kb_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/keys_method"/>
        </service>
        <!-- v1.6: apps on this TV bind here to get the phone trackpad (Messenger; see docs/trackpad.md) -->
        <service android:name=".PadService" android:exported="true">
            <intent-filter>
                <action android:name="io.github.tvoverlaysuite.TRACKPAD"/>
            </intent-filter>
        </service>
        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
